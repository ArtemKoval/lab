{
  "name": "crm",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-trixie",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "workspaceFolder": "/workspaces/crm",
  "postCreateCommand": "git config --global --add safe.directory /workspaces/crm && curl -LsSf https://astral.sh/uv/install.sh | sh && $HOME/.local/bin/uv sync && npm install",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
