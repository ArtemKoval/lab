{
  "name": "crm",
  "version": 2,
  "managedBy": "CDK",
  "tags": {
    "project": "crm"
  },
  "runtimes": [
    {
      "name": "agent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "runtime",
      "runtimeVersion": "PYTHON_3_12",
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 60
      },
      "instrumentation": {
        "enableOtel": false
      },
      "additionalContracts": ["contract.json"]
    },
    {
      "name": "copilot",
      "build": "CodeZip",
      "entrypoint": "copilot.py",
      "codeLocation": "runtime",
      "runtimeVersion": "PYTHON_3_12",
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 60
      },
      "instrumentation": {
        "enableOtel": false
      },
      "additionalContracts": ["copilot_contract.json"]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "OPENROUTER_API_KEY"
    },
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "CRM_AGENT_KEY"
    },
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "DATABASE_URL"
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "contractEngines": [],
  "configBundles": [],
  "harnesses": []
}
