# Copy to .env. Every variable is optional.
# The model key for OpenRouter. Without it, the tests and the e2e still run.
OPENROUTER_API_KEY=
# Another model on OpenRouter. The default model runs with low reasoning effort.
MODEL_NAME=
# The SQLite file. The default is crm.db at the crm root.
CRM_DB=
# The active domain pack under crm/domains/. The default is insurance.
CRM_DOMAIN=
# Where the agent finds the backend. The default is http://127.0.0.1:8000.
CRM_API=
# Where the backend finds the agent service. The default is http://127.0.0.1:8002.
CRM_AGENT_SERVICE=
# The Postgres database. Absent means the local SQLite file.
DATABASE_URL=
