{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test \"test/**/*.test.mjs\""
  },
  "mutate": [
    "src/**/*.js",
    "!src/core.js"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "timeoutMS": 60000,
  "disableTypeChecks": false
}
