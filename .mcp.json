{
    "mcpServers": {
        "zai-routing-audit": {
            "command": "tools/zai_routing_audit/.venv/bin/python",
            "args": ["-m", "zai_routing_audit.mcp_server"],
            "env": {
                "PYTHONPATH": "tools/zai_routing_audit"
            }
        },
        "dspy-gate": {
            "command": "tools/dspy_gate/.venv/bin/python",
            "args": ["-m", "dspy_gate.mcp_server"],
            "env": {
                "PYTHONPATH": "tools/dspy_gate"
            }
        }
    }
}
