[run]
branch = True
omit =
    # The -m entry point only calls cli.main, which the suite tests directly.
    tools/zai_routing_audit/zai_routing_audit/__main__.py
    tools/devcontainer_init/devcontainer_init/__main__.py
    tools/plan_exec/plan_exec/__main__.py
    tools/spec_ste_check/spec_ste_check/__main__.py
    tools/handover_telemetry/handover_telemetry/__main__.py
    tools/dspy_gate/dspy_gate/__main__.py
    tools/peak_hours_gate/peak_hours_gate/__main__.py
    tools/process_issues/process_issues/__main__.py
    tools/spec_mining/spec_mining/__main__.py

[report]
exclude_lines =
    pragma: no cover
    # The script entry guard only calls main, which the suite tests
    # directly.
    ^\s*if __name__ == .__main__.:\s*$
