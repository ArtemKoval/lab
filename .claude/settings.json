{
    "outputStyle": "ASD-STE100",
    "enabledMcpjsonServers": ["zai-routing-audit"],
    "permissions": {
        "allow": [
            "mcp__zai-routing-audit",
            "Bash(tools/zai_routing_audit/.venv/bin/python:*)",
            "Bash(gh issue create:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-ste-gate.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness-charter.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ]
    }
}
