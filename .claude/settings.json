{
    "outputStyle": "ASD-STE100",
    "enabledMcpjsonServers": ["zai-routing-audit"],
    "permissions": {
        "allow": [
            "mcp__zai-routing-audit",
            "Bash(tools/zai_routing_audit/.venv/bin/python:*)",
            "Bash(gh issue create:*)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness-charter.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ]
    }
}
