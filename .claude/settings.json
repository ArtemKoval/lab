{
    "outputStyle": "ASD-STE100",
    "statusLine": {
        "type": "command",
        "command": "/home/repos/lab/tools/zai_routing_audit/.venv/bin/python /home/repos/lab/tools/session_statusline/session_statusline.py",
        "padding": 0,
        "refreshInterval": 15
    },
    "enabledMcpjsonServers": [
        "zai-routing-audit",
        "dspy-gate"
    ],
    "permissions": {
        "allow": [
            "mcp__zai-routing-audit",
            "mcp__dspy-gate",
            "Bash(tools/zai_routing_audit/.venv/bin/python:*)",
            "Bash(gh issue create:*)",
            "Bash(gh issue list:*)",
            "Bash(gh issue view:*)",
            "Bash(gh issue comment:*)",
            "Bash(gh issue edit:*)",
            "Bash(gh issue close:*)",
            "Bash(gh label list:*)",
            "Bash(gh label create:*)",
            "Bash(gh pr list:*)",
            "Bash(gh pr view:*)",
            "Bash(gh pr create:*)",
            "Bash(gh pr merge:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-ste-gate.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    },
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-gates-protect.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            },
            {
                "matcher": "Task|Agent|Workflow|WebSearch|WebFetch|Bash|mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/peak-hours-gate.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            },
            {
                "matcher": "Task|Agent|Workflow|WebSearch|WebFetch|Bash|mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/halt-gate.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-gates-bridge.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness-charter.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cc-logging.sh\"",
                        "timeout": 10,
                        "async": false,
                        "shell": "bash"
                    }
                ]
            }
        ]
    }
}
